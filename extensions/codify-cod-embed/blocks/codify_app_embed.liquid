<!-- Codify App Embed: Cash on Delivery (COD) 1-Click Fast Checkout -->
{% if block.settings.enable_app %}
<div id="codify-app-embed-root" data-app-embed="true">
  <!-- Dynamic Injection Script & Styles -->
  <style>
    @keyframes codifyPulseAnim {
      0% { transform: scale(1); box-shadow: 0 4px 14px rgba(5, 150, 105, 0.4); }
      50% { transform: scale(1.02); box-shadow: 0 8px 22px rgba(5, 150, 105, 0.6); }
      100% { transform: scale(1); box-shadow: 0 4px 14px rgba(5, 150, 105, 0.4); }
    }
    @keyframes codifyFadeIn {
      from { opacity: 0; transform: scale(0.96) translateY(8px); }
      to { opacity: 1; transform: scale(1) translateY(0); }
    }
    .codify-injected-btn {
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      gap: 10px !important;
      width: 100% !important;
      margin: 12px 0 !important;
      padding: 16px 20px !important;
      background: {{ block.settings.button_color | default: '#059669' }} !important;
      color: #ffffff !important;
      font-family: inherit !important;
      font-size: 16px !important;
      font-weight: 700 !important;
      text-transform: none !important;
      letter-spacing: 0.3px !important;
      border: none !important;
      border-radius: {{ block.settings.button_radius | default: '12' }}px !important;
      cursor: pointer !important;
      transition: all 0.2s ease !important;
      box-shadow: 0 4px 16px rgba(5, 150, 105, 0.35) !important;
      box-sizing: border-box !important;
      animation: codifyPulseAnim 2.4s infinite !important;
      z-index: 10 !important;
    }
    .codify-injected-btn:hover {
      opacity: 0.95 !important;
      transform: translateY(-1px) !important;
      box-shadow: 0 6px 20px rgba(5, 150, 105, 0.5) !important;
    }
    /* Mobile Sticky Bar */
    .codify-sticky-bar {
      display: none;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 12px 16px;
      background: #ffffff;
      box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.12);
      z-index: 99999;
      box-sizing: border-box;
      align-items: center;
      gap: 12px;
    }
    @media (max-width: 768px) {
      .codify-sticky-bar.codify-active {
        display: flex !important;
      }
    }
  </style>

  <!-- Sticky Bar (Mobile Only) -->
  {% if block.settings.enable_sticky and template contains 'product' %}
  <div id="codify-sticky-bar" class="codify-sticky-bar codify-active">
    <div style="flex:1; min-width:0;">
      <div style="font-size:13px; font-weight:700; color:#0f172a; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
        {{ product.title | default: 'Product' }}
      </div>
      <div style="font-size:14px; font-weight:800; color:#059669;">
        {{ product.price | money }}
      </div>
    </div>
    <button type="button" class="codify-open-trigger" style="flex:1.2; padding:12px 16px; background:{{ block.settings.button_color | default: '#059669' }}; color:#fff; font-weight:700; font-size:14px; border:none; border-radius:8px; cursor:pointer; box-shadow:0 4px 12px rgba(5,150,105,0.3);">
      ⚡ Cash on Delivery
    </button>
  </div>
  {% endif %}

  <!-- 1-Click COD Modal Overlay -->
  <div id="codify-app-modal-overlay" style="display:none; position:fixed; top:0; left:0; width:100vw; height:100vh; background:rgba(15,23,42,0.75); z-index:999999999; justify-content:center; align-items:center; padding:14px; box-sizing:border-box; backdrop-filter:blur(6px); -webkit-backdrop-filter:blur(6px);">
    <div style="background:#ffffff; width:100%; max-width:540px; border-radius:20px; box-shadow:0 25px 60px -15px rgba(0,0,0,0.35); overflow:hidden; font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; animation:codifyFadeIn 0.25s cubic-bezier(0.16, 1, 0.3, 1); position:relative; max-height:92vh; display:flex; flex-direction:column; box-sizing:border-box;">
      
      <!-- Top Modal Header -->
      <div style="background:linear-gradient(135deg, {{ block.settings.button_color | default: '#059669' }} 0%, #047857 100%); color:#ffffff; padding:18px 24px; text-align:center; position:relative; flex-shrink:0;">
        <button type="button" id="codify-app-close-btn" style="position:absolute; top:14px; right:16px; background:rgba(255,255,255,0.2); border:none; color:#ffffff; font-size:22px; width:32px; height:32px; border-radius:50%; cursor:pointer; display:flex; align-items:center; justify-content:center; line-height:1; transition:background 0.2s;">&times;</button>
        <div style="display:inline-flex; align-items:center; justify-content:center; width:36px; height:36px; background:rgba(255,255,255,0.2); border-radius:50%; margin-bottom:6px; font-size:18px;">📦</div>
        <h2 style="margin:0; font-size:19px; font-weight:800; letter-spacing:-0.3px; color:#ffffff;">Cash on Delivery Checkout</h2>
        <p style="margin:4px 0 0 0; font-size:12.5px; color:#d1fae5; font-weight:500;">Pay with cash when your parcel arrives at your doorstep!</p>
      </div>

      <!-- Scarcity Countdown Timer -->
      {% if block.settings.show_timer %}
      <div style="background:#fffbeb; border-bottom:1px solid #fef3c7; padding:8px 16px; display:flex; align-items:center; justify-content:center; gap:8px; font-size:12px; font-weight:700; color:#92400e; flex-shrink:0;">
        <span>⏱️ High demand! Cart stock reserved for:</span>
        <span id="codify-app-timer" style="background:#fde68a; color:#78350f; padding:2px 8px; border-radius:6px; font-family:monospace; font-weight:800; font-size:13px;">14:59</span>
      </div>
      {% endif %}

      <!-- Scrollable Content -->
      <div style="overflow-y:auto; padding:0; flex:1; -webkit-overflow-scrolling:touch;">
        
        <!-- Product Quick Summary -->
        <div style="background:#f8fafc; padding:14px 20px; border-bottom:1px solid #e2e8f0; display:flex; justify-content:space-between; align-items:center; gap:12px;">
          <div style="display:flex; align-items:center; gap:12px; min-width:0;">
            {% if product.featured_image %}
              <img id="codify-modal-img" src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ product.title | escape }}" style="width:48px; height:48px; object-fit:cover; border-radius:10px; border:1px solid #e2e8f0; flex-shrink:0;" />
            {% else %}
              <div id="codify-modal-img-placeholder" style="width:48px; height:48px; background:#e2e8f0; border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:20px; flex-shrink:0;">🛍️</div>
            {% endif %}
            <div style="min-width:0;">
              <div style="font-size:13.5px; font-weight:700; color:#0f172a; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;" id="codify-modal-title">
                {{ product.title | default: 'Selected Product' }}
              </div>
              <div style="font-size:12.5px; color:#64748b; margin-top:2px; font-weight:600;">
                <span id="codify-modal-unit-price">{{ product.price | money }}</span> • <span style="color:#059669; font-weight:700;">✓ In Stock</span>
              </div>
            </div>
          </div>

          <!-- Quantity Stepper -->
          <div style="display:flex; align-items:center; background:#ffffff; border:1.5px solid #cbd5e1; border-radius:8px; overflow:hidden; flex-shrink:0;">
            <button type="button" id="codify-modal-qty-minus" style="width:30px; height:30px; border:none; background:#ffffff; font-weight:800; cursor:pointer; font-size:16px; color:#334155; display:flex; align-items:center; justify-content:center;">-</button>
            <span id="codify-modal-qty-display" style="font-weight:800; font-size:13.5px; min-width:26px; text-align:center; color:#0f172a;">1</span>
            <button type="button" id="codify-modal-qty-plus" style="width:30px; height:30px; border:none; background:#ffffff; font-weight:800; cursor:pointer; font-size:16px; color:#334155; display:flex; align-items:center; justify-content:center;">+</button>
          </div>
        </div>

        <!-- Form Fields -->
        <form id="codify-app-form" style="padding:20px; display:flex; flex-direction:column; gap:14px; margin:0; box-sizing:border-box;">
          
          <!-- Full Name -->
          <div>
            <label style="display:block; font-size:12px; font-weight:800; color:#1e293b; margin-bottom:5px;">Full Name <span style="color:#ef4444;">*</span></label>
            <input type="text" id="codify-field-name" required placeholder="e.g. Ali Ahmed" style="width:100%; box-sizing:border-box; padding:12px 14px; border:1.5px solid #cbd5e1; border-radius:10px; font-size:14px; color:#0f172a; outline:none; transition:border 0.2s;" />
          </div>

          <!-- Phone Number -->
          <div>
            <label style="display:block; font-size:12px; font-weight:800; color:#1e293b; margin-bottom:5px;">Phone Number (WhatsApp Active) <span style="color:#ef4444;">*</span></label>
            <div style="display:flex; gap:8px;">
              <div style="background:#f1f5f9; border:1.5px solid #cbd5e1; border-radius:10px; padding:0 12px; display:flex; align-items:center; font-size:13px; font-weight:700; color:#475569; flex-shrink:0;">
                🇵🇰 +92
              </div>
              <input type="tel" id="codify-field-phone" required placeholder="0300 1234567" style="flex:1; width:100%; box-sizing:border-box; padding:12px 14px; border:1.5px solid #cbd5e1; border-radius:10px; font-size:14px; color:#0f172a; outline:none; transition:border 0.2s;" />
            </div>
          </div>

          <!-- City Selection -->
          <div>
            <label style="display:block; font-size:12px; font-weight:800; color:#1e293b; margin-bottom:5px;">City <span style="color:#ef4444;">*</span></label>
            <input list="codify-cities-datalist" id="codify-field-city" required placeholder="Search or type your city (e.g. Lahore, Karachi)" style="width:100%; box-sizing:border-box; padding:12px 14px; border:1.5px solid #cbd5e1; border-radius:10px; font-size:14px; color:#0f172a; outline:none; transition:border 0.2s;" />
            <datalist id="codify-cities-datalist">
              <option value="Karachi">
              <option value="Lahore">
              <option value="Islamabad">
              <option value="Rawalpindi">
              <option value="Faisalabad">
              <option value="Multan">
              <option value="Peshawar">
              <option value="Quetta">
              <option value="Sialkot">
              <option value="Gujranwala">
              <option value="Hyderabad">
              <option value="Bahawalpur">
              <option value="Sargodha">
              <option value="Abbottabad">
              <option value="Sukkur">
              <option value="Wah Cantt">
            </datalist>
          </div>

          <!-- Complete Address -->
          <div>
            <label style="display:block; font-size:12px; font-weight:800; color:#1e293b; margin-bottom:5px;">Complete Delivery Address <span style="color:#ef4444;">*</span></label>
            <textarea id="codify-field-address" required rows="2" placeholder="House / Flat No, Street, Sector, Landmark" style="width:100%; box-sizing:border-box; padding:12px 14px; border:1.5px solid #cbd5e1; border-radius:10px; font-size:14px; color:#0f172a; outline:none; resize:none; font-family:inherit; transition:border 0.2s;"></textarea>
          </div>

          <!-- Upsell / Addon Option -->
          {% if block.settings.enable_addon %}
          <div style="background:#f0fdf4; border:1.5px dashed #86efac; border-radius:12px; padding:12px 14px; display:flex; align-items:center; gap:12px; cursor:pointer;" id="codify-addon-box">
            <input type="checkbox" id="codify-field-addon" style="width:18px; height:18px; accent-color:#059669; cursor:pointer;" />
            <label for="codify-field-addon" style="cursor:pointer; flex:1; font-size:12.5px; color:#166534; font-weight:600; line-height:1.3;">
              <strong style="display:block; font-size:13px; color:#14532d;">⚡ Add VIP Priority Inspection & Shipping Guarantee</strong>
              Get insured, expedited dispatch for only <strong style="color:#059669;">Rs. {{ block.settings.addon_price | default: '99' }}</strong>
            </label>
          </div>
          {% endif %}

          <!-- Order Summary Calculation Table -->
          <div style="background:#f8fafc; border-radius:12px; padding:12px 16px; border:1px solid #e2e8f0; font-size:13px;">
            <div style="display:flex; justify-content:space-between; color:#64748b; margin-bottom:6px;">
              <span>Subtotal (<span id="codify-sum-qty">1</span> item):</span>
              <span id="codify-sum-subtotal" style="font-weight:600; color:#1e293b;">{{ product.price | money }}</span>
            </div>
            <div style="display:flex; justify-content:space-between; color:#64748b; margin-bottom:6px;">
              <span>Delivery Charges (COD):</span>
              <span style="font-weight:700; color:#059669;">{{ block.settings.shipping_fee | default: 'FREE' }}</span>
            </div>
            <div id="codify-sum-addon-row" style="display:none; justify-content:space-between; color:#64748b; margin-bottom:6px;">
              <span>VIP Shipping Guarantee:</span>
              <span style="font-weight:600; color:#1e293b;">Rs. {{ block.settings.addon_price | default: '99' }}</span>
            </div>
            <div style="border-top:1px dashed #cbd5e1; padding-top:8px; margin-top:6px; display:flex; justify-content:space-between; font-size:15px; font-weight:800; color:#0f172a;">
              <span>Total Payable (COD):</span>
              <span id="codify-sum-total" style="color:#059669;">{{ product.price | money }}</span>
            </div>
          </div>

          <!-- Error Alert Banner -->
          <div id="codify-error-banner" style="display:none; background:#fef2f2; border:1px solid #fecaca; color:#b91c1c; padding:10px 14px; border-radius:8px; font-size:13px; font-weight:600;"></div>

          <!-- Submit Order Button -->
          <button type="submit" id="codify-submit-btn" style="width:100%; padding:16px 20px; background:linear-gradient(135deg, {{ block.settings.button_color | default: '#059669' }} 0%, #047857 100%); color:#ffffff; font-size:16px; font-weight:800; border:none; border-radius:12px; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:8px; box-shadow:0 8px 24px -4px rgba(5,150,105,0.4); transition:all 0.2s;">
            <span>✓ Complete Order Cash on Delivery</span>
          </button>

          <div style="display:flex; justify-content:center; align-items:center; gap:16px; font-size:11.5px; color:#64748b; font-weight:600; margin-top:2px;">
            <span>🔒 100% Safe Checkout</span>
            <span>🇵🇰 Delivery Across Pakistan</span>
            <span>⚡ Fast Dispatch</span>
          </div>
        </form>

        <!-- Order Success State -->
        <div id="codify-success-view" style="display:none; padding:32px 24px; text-align:center;">
          <div style="width:68px; height:68px; background:#dcfce7; color:#16a34a; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:36px; margin:0 auto 16px;">
            ✓
          </div>
          <h3 style="margin:0 0 6px 0; font-size:22px; font-weight:800; color:#0f172a;">Order Placed Successfully!</h3>
          <p style="margin:0 0 20px 0; color:#64748b; font-size:14px;">
            Thank you! Your Cash on Delivery order <strong id="codify-success-ord-num" style="color:#059669;">#COD-PENDING</strong> has been received.
          </p>

          <div style="background:#f8fafc; border-radius:12px; padding:16px; margin-bottom:20px; text-align:left; font-size:13px; border:1px solid #e2e8f0;">
            <div style="margin-bottom:6px;"><strong>Name:</strong> <span id="codify-succ-name">-</span></div>
            <div style="margin-bottom:6px;"><strong>Phone:</strong> <span id="codify-succ-phone">-</span></div>
            <div style="margin-bottom:6px;"><strong>Delivery City:</strong> <span id="codify-succ-city">-</span></div>
            <div><strong>Payment Mode:</strong> <span style="color:#059669; font-weight:700;">Cash on Delivery (Pay upon arrival)</span></div>
          </div>

          <a id="codify-whatsapp-support-btn" href="#" target="_blank" style="display:flex; align-items:center; justify-content:center; gap:8px; width:100%; padding:14px; background:#25d366; color:#ffffff; text-decoration:none; border-radius:12px; font-weight:700; font-size:14px; margin-bottom:12px; box-sizing:border-box;">
            <span>💬 Track or Confirm via WhatsApp</span>
          </a>

          <button type="button" id="codify-success-close-btn" style="width:100%; padding:12px; background:#f1f5f9; color:#475569; font-weight:700; border:none; border-radius:10px; cursor:pointer; font-size:14px;">
            Continue Shopping
          </button>
        </div>

      </div>
    </div>
  </div>

  <!-- Client-Side Automation Script -->
  <script>
    (function() {
      if (window.__codifyAppEmbedInitialized) return;
      window.__codifyAppEmbedInitialized = true;

      let currentQty = 1;
      let rawBasePrice = {{ product.price | default: 349900 | json }} / 100;
      let variantId = {{ product.selected_or_first_available_variant.id | default: 0 | json }};
      let productTitle = {{ product.title | default: 'Selected Item' | json }};
      const addonPrice = {{ block.settings.addon_price | default: 99 | json }};
      const autoInject = {{ block.settings.auto_inject | default: true | json }};
      const btnText = {{ block.settings.button_text | default: 'Order Cash on Delivery (COD)' | json }};

      function formatMoney(amount) {
        return 'Rs. ' + Number(amount).toLocaleString('en-PK', { maximumFractionDigits: 0 });
      }

      function updateCalculations() {
        const qtyDisplay = document.getElementById('codify-modal-qty-display');
        const sumQty = document.getElementById('codify-sum-qty');
        const sumSubtotal = document.getElementById('codify-sum-subtotal');
        const sumTotal = document.getElementById('codify-sum-total');
        const addonRow = document.getElementById('codify-sum-addon-row');
        const addonCheckbox = document.getElementById('codify-field-addon');

        if (qtyDisplay) qtyDisplay.innerText = currentQty;
        if (sumQty) sumQty.innerText = currentQty;

        let subtotal = rawBasePrice * currentQty;
        if (sumSubtotal) sumSubtotal.innerText = formatMoney(subtotal);

        let total = subtotal;
        if (addonCheckbox && addonCheckbox.checked) {
          total += addonPrice;
          if (addonRow) addonRow.style.display = 'flex';
        } else {
          if (addonRow) addonRow.style.display = 'none';
        }

        if (sumTotal) sumTotal.innerText = formatMoney(total);
      }

      function openModal() {
        const overlay = document.getElementById('codify-app-modal-overlay');
        if (!overlay) return;
        
        // sync with live product page variant if available
        try {
          const variantInput = document.querySelector('select[name="id"], input[name="id"]');
          if (variantInput && variantInput.value) {
            variantId = variantInput.value;
          }
        } catch(e) {}

        overlay.style.display = 'flex';
        updateCalculations();
      }

      function closeModal() {
        const overlay = document.getElementById('codify-app-modal-overlay');
        if (overlay) overlay.style.display = 'none';
      }

      // Auto-inject COD button on Product Page
      function injectButton() {
        if (!autoInject) return;
        if (document.getElementById('codify-injected-buy-btn')) return;

        const targetSelectors = [
          'form[action*="/cart/add"] button[type="submit"]',
          '.product-form__buttons',
          'button[name="add"]',
          '.shopify-payment-button',
          '.product__buy-buttons',
          'form[action*="/cart/add"]',
          '.add-to-cart'
        ];

        let targetElem = null;
        for (let sel of targetSelectors) {
          const el = document.querySelector(sel);
          if (el) {
            targetElem = el;
            break;
          }
        }

        if (targetElem) {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.id = 'codify-injected-buy-btn';
          btn.className = 'codify-injected-btn';
          btn.innerHTML = '<span>⚡</span> <span>' + btnText + '</span>';
          btn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            openModal();
          });

          // Insert right below or inside form
          if (targetElem.parentElement && targetElem.tagName === 'BUTTON') {
            targetElem.parentElement.insertBefore(btn, targetElem.nextSibling);
          } else {
            targetElem.appendChild(btn);
          }
        }
      }

      // Setup Listeners
      function init() {
        injectButton();

        // Plus/Minus
        const minusBtn = document.getElementById('codify-modal-qty-minus');
        const plusBtn = document.getElementById('codify-modal-qty-plus');
        if (minusBtn) {
          minusBtn.onclick = function() {
            if (currentQty > 1) {
              currentQty--;
              updateCalculations();
            }
          };
        }
        if (plusBtn) {
          plusBtn.onclick = function() {
            currentQty++;
            updateCalculations();
          };
        }

        // Addon Checkbox toggle
        const addonCheckbox = document.getElementById('codify-field-addon');
        if (addonCheckbox) {
          addonCheckbox.onchange = updateCalculations;
        }

        // Close triggers
        const closeBtn = document.getElementById('codify-app-close-btn');
        const succCloseBtn = document.getElementById('codify-success-close-btn');
        const overlay = document.getElementById('codify-app-modal-overlay');

        if (closeBtn) closeBtn.onclick = closeModal;
        if (succCloseBtn) succCloseBtn.onclick = closeModal;
        if (overlay) {
          overlay.onclick = function(e) {
            if (e.target === overlay) closeModal();
          };
        }

        // All triggers
        document.querySelectorAll('.codify-open-trigger, .codify-open-modal, [data-codify-trigger]').forEach(function(el) {
          el.onclick = function(e) {
            e.preventDefault();
            openModal();
          };
        });

        // Form Submit Handler
        const form = document.getElementById('codify-app-form');
        if (form) {
          form.onsubmit = async function(e) {
            e.preventDefault();
            const submitBtn = document.getElementById('codify-submit-btn');
            const errBanner = document.getElementById('codify-error-banner');
            if (errBanner) errBanner.style.display = 'none';

            const name = document.getElementById('codify-field-name').value.trim();
            const phone = document.getElementById('codify-field-phone').value.trim();
            const city = document.getElementById('codify-field-city').value.trim();
            const address = document.getElementById('codify-field-address').value.trim();
            const hasAddon = addonCheckbox ? addonCheckbox.checked : false;

            if (!name || !phone || !city || !address) {
              if (errBanner) {
                errBanner.innerText = 'Please fill in all required fields.';
                errBanner.style.display = 'block';
              }
              return;
            }

            if (submitBtn) {
              submitBtn.disabled = true;
              submitBtn.innerHTML = '<span>⏳ Confirming Order...</span>';
            }

            try {
              const orderPayload = {
                customer: {
                  first_name: name,
                  phone: phone.startsWith('+') ? phone : '+92' + phone.replace(/^0/, ''),
                  shipping_address: {
                    first_name: name,
                    address1: address,
                    city: city,
                    country: 'Pakistan',
                    country_code: 'PK',
                    phone: phone
                  }
                },
                line_items: [
                  {
                    variant_id: variantId || undefined,
                    title: productTitle,
                    quantity: currentQty,
                    price: rawBasePrice
                  }
                ],
                addons: hasAddon ? [{ title: 'VIP Priority Shipping Guarantee', price: addonPrice }] : [],
                note: 'COD Order via Codify App Embed. City: ' + city,
                tags: ['COD', 'Codify-1Click', 'App-Embed']
              };

              // Send to App Order Creation API Endpoint
              const res = await fetch('/apps/codify-checkout', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(orderPayload)
              }).catch(() => null);

              let orderData = null;
              if (res && res.ok) {
                orderData = await res.json();
              }

              // Show Success View
              const formElem = document.getElementById('codify-app-form');
              const succElem = document.getElementById('codify-success-view');
              if (formElem) formElem.style.display = 'none';
              if (succElem) {
                succElem.style.display = 'block';
                const ordNum = (orderData && (orderData.order_name || orderData.id)) ? (orderData.order_name || '#' + orderData.id) : ('#COD-' + Math.floor(100000 + Math.random() * 900000));
                document.getElementById('codify-success-ord-num').innerText = ordNum;
                document.getElementById('codify-succ-name').innerText = name;
                document.getElementById('codify-succ-phone').innerText = phone;
                document.getElementById('codify-succ-city').innerText = city;

                const waBtn = document.getElementById('codify-whatsapp-support-btn');
                if (waBtn) {
                  const waMsg = encodeURIComponent('Hello! I just placed a COD order ' + ordNum + ' for ' + productTitle + '. Please confirm delivery to ' + city + '.');
                  waBtn.href = 'https://wa.me/923000000000?text=' + waMsg;
                }
              }
            } catch (err) {
              console.error('COD Order creation error:', err);
              if (errBanner) {
                errBanner.innerText = 'Could not place order directly. Please check your connection or contact support.';
                errBanner.style.display = 'block';
              }
            } finally {
              if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<span>✓ Complete Order Cash on Delivery</span>';
              }
            }
          };
        }

        // Urgency Timer Countdown
        let timeLeft = 14 * 60 + 59;
        const timerElem = document.getElementById('codify-app-timer');
        if (timerElem) {
          setInterval(function() {
            if (timeLeft <= 0) return;
            timeLeft--;
            const mins = Math.floor(timeLeft / 60);
            const secs = timeLeft % 60;
            timerElem.innerText = (mins < 10 ? '0' : '') + mins + ':' + (secs < 10 ? '0' : '') + secs;
          }, 1000);
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
      document.addEventListener('shopify:section:load', init);
    })();
  </script>
</div>
{% endif %}

